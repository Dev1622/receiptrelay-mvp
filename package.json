{
  "name": "receiptrelay-mvp",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node server/server.js",
    "preview": "vite preview --host 0.0.0.0",
    "check": "node --check server/server.js && node --check server/services/paypal.js && node --check server/services/agent.js",
    "test": "node server/smoke-test.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.468.0",
    "express": "^4.21.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "concurrently": "^9.1.2"
  },
  "devDependencies": {}
}